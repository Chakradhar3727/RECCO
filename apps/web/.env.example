# ──────────────────────────────────────────────────
# RECCO EPR SaaS Platform — Environment Variables
# Copy to .env.local and fill in values
# ──────────────────────────────────────────────────

# ── App ──
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── Blockchain (Polygon Amoy Testnet) ──
NEXT_PUBLIC_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
RECCO_CONTRACT_ADDRESS=0x_deployed_in_phase_8
BLOCKCHAIN_PRIVATE_KEY=your_deployer_private_key

# ── OCR ──
OCR_SPACE_API_KEY=your_ocr_space_api_key

# ── Email (Resend) ──
RESEND_API_KEY=your_resend_api_key

# ── Payments (Razorpay) ──
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Security ──
HMAC_SECRET=generate_64_char_hex_secret
ADMIN_ALLOWED_EMAILS=admin@recco.in

# ── Rate Limiting (Upstash Redis) ──
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ── Deployment ──
VERCEL_TOKEN=your_vercel_token
GITHUB_TOKEN=your_github_token
